-- allium: 3
-- katan-alysis.allium
--
-- Scope: the JFR analysis desktop application — opening one or more
-- recordings, narrowing the active one with the cross-cutting filters,
-- and reading the flat profile ("top methods"), flamegraph and heatmap
-- views.
--
-- Includes:
--   - the outcome of opening a recording (loaded summary vs. error)
--   - opening more than one recording at once, switching which one is
--     shown, and closing one without disturbing the others
--   - the recent-recordings list: remembered opens, persisted across
--     application restarts, independent of what is currently open
--   - the normalised profile: frames, stacks, threads, samples
--   - the recording's own description (JVM, GC, host, key flags) and
--     the overview that presents it with the recorded signals
--   - the thread and time filters, applied before any aggregation, kept
--     separately for each open recording
--   - the top-methods aggregation (self / total sample counts)
--   - the flamegraph: the same selection's call stacks merged into a
--     tree by shared prefix, preserving recursion instead of
--     collapsing it, with the analyst able to zoom into a subtree and
--     back out to any ancestor by scrolling up to it and clicking it
--   - the heatmap: sample density over the whole recording, bucketed
--     into one-second columns of twenty-millisecond rows so a
--     periodic pattern lines up down the columns, with the analyst
--     able to brush a rectangle of cells into a time window
--   - the merged callers/callees view: callers and callees of one
--     method the analyst focuses on, reached by selecting it from
--     top-methods or the flamegraph
--   - the boundaries the analyst interacts with
-- Excludes:
--   - the JFR binary format and its parsing (jfrs library, external)
--   - transport (Tauri IPC), rendering technology and packaging

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    workspace: AnalysisWorkspace
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A JFR file on disk. Produced by a JVM or by async-profiler; the
-- application only ever reads it.
external entity Recording {
    path: String
}

-- The person driving the application. The system holds no account or
-- identity of its own; the analyst is whoever operates the workspace.
external entity Analyst {
    name: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- An interval of recording-relative nanoseconds, both bounds included:
-- the analyst who selects the whole span keeps every sample, last one
-- included. A window whose end precedes its start holds no instant and
-- is therefore empty — it narrows nothing.
value TimeWindow {
    start_nanos: Integer
    end_nanos: Integer

    duration_nanos: end_nanos - start_nanos
    is_empty: end_nanos < start_nanos
}

-- One line of the welcome screen's recents list: enough to recognise a
-- recording and reopen it, nothing read from inside the file.
value RecentEntry {
    path: String
    size_bytes: Integer
    last_opened_ms: Integer
    -- Checked when the list is shown, not when it was saved: a file
    -- deleted since its last open is marked missing — it cannot be
    -- reopened, only removed from the list.
    still_on_disk: Boolean
}

-- A selection the analyst saved under a name: the two filters, frozen.
-- Null halves mean the same as on the recording — not narrowed.
value SavedSelection {
    name: String
    threads: Set<ProfiledThread>?
    window: TimeWindow?
}

-- A JVM flag captured at recording start: its value and where it came
-- from ("Command line", "Ergonomic", "Default"...). The origin is what
-- lets the analyst tell an explicit -Xmx from an ergonomic one.
value JvmFlag {
    value: Integer
    origin: String
}

-- Boolean twin of JvmFlag, for on/off diagnostics flags.
value ToggleFlag {
    enabled: Boolean
    origin: String
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A method, identified independently of where it appears in a stack.
-- Two occurrences of the same method are the same frame.
entity Frame {
    profile: Profile
    class_name: String
    method_name: String

    -- Samples whose innermost frame is this method: it was the one
    -- running on CPU.
    leaf_samples: Sample with leaf_frame = this
    -- Samples that have this method anywhere in their stack. Counted
    -- once per sample, even when the stack recurses through it.
    covering_samples: Sample with this in distinct_frames

    -- Both counts are relative to the current selection: filters are
    -- applied to the sample stream before anything is aggregated.
    selected_leaf_samples: leaf_samples where is_selected
    selected_covering_samples: covering_samples where is_selected

    self_samples: selected_leaf_samples.count
    total_samples: selected_covering_samples.count

    is_visible: total_samples > 0
}

-- One call stack, root first and leaf last. Stacks are shared: many
-- samples point at the same stack.
entity Stack {
    profile: Profile
    frames: List<Frame>

    leaf: frames.last
    distinct_frames: frames.unique

    -- Every sample that ran this exact call stack.
    samples: Sample with stack = this
    -- Relative to the current selection, like Frame's counts: the
    -- flamegraph's span widths are proportional to this.
    selected_samples: samples where is_selected
    selected_sample_count: selected_samples.count
}

-- A thread observed in the recording.
entity ProfiledThread {
    profile: Profile
    name: String

    -- Whole-recording activity, deliberately blind to the current
    -- selection: the thread panel orders and annotates by it, and
    -- entries must not jump around while the analyst filters.
    samples: Sample with thread = this
    sample_count: samples.count
}

-- One execution sample: an instant, a thread, and the stack that
-- thread was running.
entity Sample {
    profile: Profile
    ts_nanos: Integer
    thread: ProfiledThread
    stack: Stack

    leaf_frame: stack.leaf
    distinct_frames: stack.distinct_frames

    -- The filters are cross-cutting: every view of a recording sees the
    -- same selected samples, so no view may re-filter or post-process
    -- aggregated data. Each recording keeps its own filters, so a
    -- sample is judged against the selection of the recording it came
    -- from, never another open recording's.
    matches_thread_filter:
        profile.open_recording.selected_threads = null
        or thread in profile.open_recording.selected_threads
    matches_time_filter:
        profile.open_recording.selected_window = null
        or (ts_nanos >= profile.open_recording.selected_window.start_nanos
            and ts_nanos <= profile.open_recording.selected_window.end_nanos)
    is_selected: matches_thread_filter and matches_time_filter
}

-- A recording turned into the shape every view consumes. Produced once
-- when the recording is opened, then only queried.
entity Profile {
    source: Recording

    frames: Frame with profile = this
    stacks: Stack with profile = this
    threads: ProfiledThread with profile = this
    samples: Sample with profile = this
    -- The one open recording this profile belongs to.
    open_recording: OpenRecording with profile = this

    -- What the recording says about the JVM that produced it. Every
    -- field may be absent — an async-profiler recording, or one made
    -- with minimal settings, carries no metadata events at all — and
    -- absence reads as "n/a", never as an error.
    jvm_name: String?
    jvm_version: String?
    young_collector: String?
    old_collector: String?
    heap_max_bytes: Integer?
    os_description: String?
    cpu_cores: Integer?
    physical_memory_bytes: Integer?
    xmx: JvmFlag?
    xms: JvmFlag?
    max_direct_memory: JvmFlag?
    debug_non_safepoints: ToggleFlag?

    sample_count: samples.count
    first_sample_nanos: earliest(samples)
    last_sample_nanos: latest(samples)
    -- The span the analyst can select within; timestamps shown to the
    -- analyst are relative to the first sample, never absolute.
    duration_nanos: last_sample_nanos - first_sample_nanos
}

-- One recording open in the workspace: its normalised profile, the
-- filters currently narrowing it, and the focus and saved selections
-- that belong to it alone. Every other open recording keeps its own —
-- narrowing one never touches another. An OpenRecording only ever
-- exists with a profile attached, so the "requires a recording"
-- invariants the single-profile workspace used to need are now
-- structural rather than asserted.
entity OpenRecording {
    workspace: AnalysisWorkspace
    profile: Profile
    -- Absent means "every thread" / "the whole recording". An empty
    -- filter is not a filter: selecting no thread, or a window holding
    -- no instant, narrows nothing rather than emptying the views. The
    -- analyst who deselects everything is not asking to see nothing,
    -- and each category is independent — an empty thread selection
    -- leaves an active time window alone.
    selected_threads: Set<ProfiledThread>?
    selected_window: TimeWindow?
    -- The method the merged-calls view is focused on, from top-methods
    -- or the flamegraph. Unlike the filters, selecting a method is not
    -- itself a filter: it survives a filter change instead of resetting
    -- with it.
    focused_frame: Frame?
    -- Selections saved under a name for this recording, in save order.
    -- In memory only: they die with the recording.
    saved_selections: List<SavedSelection>

    -- Whether this is the recording whose views are currently shown.
    is_active: this = workspace.active_recording

    selected_samples: profile.samples where is_selected
    -- The denominator of every percentage the analyst reads for this
    -- recording.
    selection_size: selected_samples.count
    top_methods: profile.frames where is_visible
    -- The distinct call stacks reached by the current selection, each
    -- with its own selected sample count: the raw material the
    -- flamegraph merges into a tree by shared prefix. Unlike
    -- top_methods, a stack's frames are not deduplicated — a method
    -- that recurses appears once per depth it occurs at.
    selected_stacks: selected_samples -> stack

    -- One name designates one saved selection; conflicts are resolved
    -- with a numeric suffix as names are taken.
    invariant SavedSelectionNamesAreUnique {
        saved_selections.name.unique.count = saved_selections.count
    }

    -- Empty filters are normalised away as they are selected, so no
    -- view has to decide what an empty filter means.
    invariant NoEmptyFilterIsEverHeld {
        (selected_threads = null or selected_threads.count > 0)
            and (selected_window = null or not selected_window.is_empty)
    }
}

-- The application state: every recording currently open, which one's
-- views are shown, and what survives across all of them.
entity AnalysisWorkspace {
    -- Every recording currently open, in the order they were opened.
    open_recordings: List<OpenRecording>
    -- Which open recording's views are currently shown. Absent only
    -- when nothing is open.
    active_recording: OpenRecording?
    -- Why the last attempt to open a recording failed, if it did.
    last_error: String?
    -- What the welcome screen lists: recordings whose last open
    -- succeeded, most recent first, across every recording ever
    -- opened — not scoped to what is currently open. Unlike the rest
    -- of the workspace this list survives an application restart.
    recent_recordings: List<RecentEntry>

    has_recording: active_recording != null
    is_recording_open(path): open_recordings.any(r => r.profile.source.path = path)

    invariant ActiveRecordingIsAmongOpenOnes {
        active_recording != null implies active_recording in open_recordings
    }

    invariant AnOpenRecordingIsAlwaysActive {
        open_recordings.count > 0 implies active_recording != null
    }

    -- Reopening an already-open path activates it rather than opening
    -- a second copy, so no two open recordings ever share a path.
    invariant NoRecordingIsOpenedTwice {
        for a in open_recordings:
            for b in open_recordings:
                a != b implies a.profile.source.path != b.profile.source.path
    }

    -- The list is a shortlist, not a history: at most ten entries, one
    -- per path — reopening a recording moves its entry to the front
    -- instead of duplicating it.
    invariant RecentsStayAShortlist {
        recent_recordings.count <= 10
            and recent_recordings.path.unique.count = recent_recordings.count
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule LoadRecording {
    when: AnalystOpensRecording(analyst, recording)
    requires: not workspace.is_recording_open(recording.path)
    requires: is_readable(recording)
    requires: has_execution_samples(recording)
    ensures:
        let profile = Profile.created(source: recording)
        let opened = OpenRecording.created(
            workspace: workspace,
            profile: profile,
            selected_threads: null,
            selected_window: null,
            focused_frame: null,
            saved_selections: [])
        -- Appends the newly opened recording after every other one
        -- already open.
        workspace.open_recordings =
            with_recording_open(workspace.open_recordings, opened)
        workspace.active_recording = opened
        workspace.last_error = null
        -- The open is remembered: the recording's entry moves to (or
        -- appears at) the front of the recents list, and the entry
        -- beyond the shortlist bound, if any, falls off the end.
        workspace.recent_recordings =
            remembered(workspace.recent_recordings, recording)
    @guidance
        -- Samples with no resolvable stack or thread contribute to no
        -- view and are dropped while reading; a recording made only of
        -- such samples is an unusable recording.
}

rule ActivateAlreadyOpenRecording {
    when: AnalystOpensRecording(analyst, recording)
    requires: workspace.is_recording_open(recording.path)
    ensures:
        for opened in workspace.open_recordings where profile.source.path = recording.path:
            workspace.active_recording = opened
        workspace.last_error = null
        workspace.recent_recordings =
            remembered(workspace.recent_recordings, recording)
}

rule RejectUnusableRecording {
    when: AnalystOpensRecording(analyst, recording)
    requires: not workspace.is_recording_open(recording.path)
    requires: not is_readable(recording) or not has_execution_samples(recording)
    ensures:
        -- The workspace keeps whatever was already open: a failed open
        -- never costs the analyst a recording they were reading, and
        -- never rewrites the recents list.
        workspace.last_error = failure_reason(recording)
}

rule ActivateOpenRecording {
    when: AnalystSelectsOpenRecording(analyst, recording)
    requires: recording in workspace.open_recordings
    ensures: workspace.active_recording = recording
}

rule CloseRecording {
    when: AnalystClosesRecording(analyst, recording)
    requires: recording in workspace.open_recordings
    ensures:
        -- Filters, focus and saved selections die with the recording
        -- they narrowed: nothing else in the workspace depends on them.
        if workspace.active_recording = recording:
            -- Prefers the open recording immediately before the closed
            -- one, falling back to the one immediately after, or to no
            -- active recording when none remain.
            workspace.active_recording =
                next_active(workspace.open_recordings, recording)
        workspace.open_recordings =
            without_recording(workspace.open_recordings, recording)
        workspace.last_error = null
}

rule ForgetRecentRecording {
    when: AnalystRemovesRecent(analyst, path)
    ensures:
        workspace.recent_recordings =
            without(workspace.recent_recordings, path)
}

rule ClearRecentRecordings {
    when: AnalystClearsRecents(analyst)
    requires: workspace.recent_recordings.count > 0
    ensures:
        workspace.recent_recordings = []
}

rule NarrowToThreads {
    when: AnalystSelectsThreads(analyst, threads)
    requires: workspace.has_recording
    ensures:
        if threads.count = 0:
            workspace.active_recording.selected_threads = null
        else:
            workspace.active_recording.selected_threads = threads
}

rule WidenToAllThreads {
    when: AnalystClearsThreadSelection(analyst)
    requires: workspace.has_recording
    requires: workspace.active_recording.selected_threads != null
    ensures: workspace.active_recording.selected_threads = null
}

rule NarrowToTimeWindow {
    when: AnalystSelectsTimeWindow(analyst, window)
    requires: workspace.has_recording
    ensures:
        -- A brush that selects no instant clears the time filter; it is
        -- how the analyst backs out of a selection, not a rejected
        -- action.
        if window.is_empty:
            workspace.active_recording.selected_window = null
        else:
            workspace.active_recording.selected_window = window
}

rule WidenToWholeRecording {
    when: AnalystClearsTimeWindow(analyst)
    requires: workspace.has_recording
    requires: workspace.active_recording.selected_window != null
    ensures: workspace.active_recording.selected_window = null
}

rule SelectMethod {
    when: AnalystSelectsMethod(analyst, frame)
    requires: workspace.has_recording
    ensures:
        -- Selecting a different method replaces the focus outright; the
        -- analyst does not have to clear it first.
        workspace.active_recording.focused_frame = frame
}

rule ClearMethodSelection {
    when: AnalystClearsMethodSelection(analyst)
    requires: workspace.has_recording
    requires: workspace.active_recording.focused_frame != null
    ensures: workspace.active_recording.focused_frame = null
}

rule SaveCurrentSelection {
    when: AnalystSavesSelection(analyst)
    requires: workspace.has_recording
    -- Saving the absence of selection would duplicate the built-in
    -- "no selection" entry, so there must be something to name.
    requires: workspace.active_recording.selected_threads != null
        or workspace.active_recording.selected_window != null
    ensures:
        -- The default name describes the selection — the period (or
        -- "whole recording") and the thread count (or "all threads");
        -- a name conflict takes the first free " (n)" suffix, n >= 2.
        workspace.active_recording.saved_selections = with_saved(
            workspace.active_recording.saved_selections,
            workspace.active_recording.selected_threads,
            workspace.active_recording.selected_window)
}

rule ApplySavedSelection {
    when: AnalystAppliesSelection(analyst, selection)
    requires: workspace.has_recording
    requires: selection in workspace.active_recording.saved_selections
    ensures:
        workspace.active_recording.selected_threads = selection.threads
        workspace.active_recording.selected_window = selection.window
}

-- The "no selection" entry of the selection menu: every thread, the
-- whole recording, in one gesture.
rule ApplyNoSelection {
    when: AnalystClearsSelection(analyst)
    requires: workspace.has_recording
    ensures:
        workspace.active_recording.selected_threads = null
        workspace.active_recording.selected_window = null
}

rule RenameSavedSelection {
    when: AnalystRenamesSelection(analyst, selection, wanted)
    requires: workspace.has_recording
    requires: selection in workspace.active_recording.saved_selections
    ensures:
        -- Same conflict rule as saving; a blank name changes nothing.
        workspace.active_recording.saved_selections = renamed(
            workspace.active_recording.saved_selections, selection, wanted)
}

rule DeleteSavedSelection {
    when: AnalystDeletesSelection(analyst, selection)
    requires: workspace.has_recording
    requires: selection in workspace.active_recording.saved_selections
    ensures:
        -- Deleting forgets the name, not the current selection: the
        -- filters the entry may have produced stay in place.
        workspace.active_recording.saved_selections = without_selection(
            workspace.active_recording.saved_selections, selection)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A method cannot be on CPU in a sample it does not appear in.
invariant SelfNeverExceedsTotal {
    for frame in Frames:
        frame.self_samples <= frame.total_samples
}

-- No method can cover more samples than its own recording's selection
-- holds — each open recording is bounded by its own selection, never
-- another open recording's.
invariant TotalBoundedBySelection {
    for frame in Frames:
        frame.total_samples <= frame.profile.open_recording.selection_size
}

-- Exactly one method is on CPU per sample, so the self counts of a
-- recording's frames partition that recording's own selection.
invariant SelfCountsPartitionTheSelection {
    for recording in OpenRecordings:
        sum_of(recording.profile.frames, f => f.self_samples)
            = recording.selection_size
}

-- Every sample belongs to the recording it was read from, and so does
-- every stack it points at.
invariant SamplesAreInternallyConsistent {
    for sample in Samples:
        sample.stack.profile = sample.profile
            and sample.thread.profile = sample.profile
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RecordingLoader {
    facing analyst: Analyst

    exposes:
        workspace.has_recording
        workspace.last_error
        for recording in workspace.open_recordings:
            recording.is_active
            recording.profile.source.path
            recording.profile.sample_count
            recording.profile.duration_nanos
        for entry in workspace.recent_recordings:
            entry.path
            entry.size_bytes
            entry.last_opened_ms
            entry.still_on_disk

    provides:
        AnalystOpensRecording(analyst, recording)
        AnalystSelectsOpenRecording(analyst, recording)
            when recording in workspace.open_recordings
        AnalystClosesRecording(analyst, recording)
            when recording in workspace.open_recordings
        AnalystRemovesRecent(analyst, path)
            when workspace.recent_recordings.count > 0
        AnalystClearsRecents(analyst)
            when workspace.recent_recordings.count > 0

    @guarantee FailedOpenIsReported
        -- Opening a recording either yields a summary or a message
        -- naming what went wrong. It never fails silently, and never
        -- leaves the analyst looking at a half-loaded recording.

    @guarantee OnlySuccessfulOpensAreRemembered
        -- The recents list is a list of recordings that actually
        -- opened: a failed open changes the error message, never the
        -- list. Removing an entry, or clearing the list, forgets the
        -- shortcut only — the file on disk is not the application's to
        -- touch.

    @guarantee RecentsSurviveARestart
        -- The list is the one piece of workspace state that outlives
        -- the process: quitting and relaunching the application shows
        -- the same recents. Everything else — which recordings are
        -- open, their filters — starts fresh.

    @guarantee OpeningIsVisibleAndSingular
        -- Parsing a large recording takes time: while an open runs, the
        -- surface says which file is being opened, and a second open
        -- cannot start until the first settles — two parses racing for
        -- the workspace would leave it in neither state.

    @guarantee ReopeningAnOpenRecordingActivatesIt
        -- Opening a path that is already open does not create a second
        -- copy alongside it: it makes the existing open recording
        -- active, exactly as if the analyst had switched to it
        -- directly, and its filters and focus are left exactly as they
        -- were.

    @guidance
        -- Switching which open recording is active, or closing one,
        -- never changes another open recording's filters, focus or
        -- saved selections — those belong to the recording alone.

    related:
        RecordingOverview() when workspace.has_recording
        TopMethodsView() when workspace.has_recording
        FlamegraphView() when workspace.has_recording
        HeatmapView() when workspace.has_recording
        MergedCallsView() when workspace.has_recording
}

-- The landing view of a freshly opened recording: what the recording
-- says about itself, and its vital signs over time.
surface RecordingOverview {
    facing analyst: Analyst

    exposes:
        workspace.active_recording.profile.jvm_name
        workspace.active_recording.profile.jvm_version
        workspace.active_recording.profile.young_collector
        workspace.active_recording.profile.old_collector
        workspace.active_recording.profile.heap_max_bytes
        workspace.active_recording.profile.os_description
        workspace.active_recording.profile.cpu_cores
        workspace.active_recording.profile.physical_memory_bytes
        workspace.active_recording.profile.xmx
        workspace.active_recording.profile.xms
        workspace.active_recording.profile.max_direct_memory
        workspace.active_recording.profile.debug_non_safepoints

    provides:
        -- Brushing a period on any chart is the "analyze this period"
        -- gesture: it narrows the time window and hands over to the
        -- top-methods view, both scoped to the active recording.
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording

    @guarantee ChartsShareTheRecordingClock
        -- The overview draws four signals — CPU load, heap occupancy,
        -- process memory (RSS), GC pauses — as recorded, over one
        -- shared time axis spanning the whole recording. The hover
        -- cursor is one cursor: pointing at an instant points at it in
        -- all four charts.

    @guarantee MissingDataIsNamed
        -- A signal the recording does not carry shows as "not in this
        -- recording", and an absent fact as "n/a" — never an empty
        -- chart the analyst could mistake for a flat line, never an
        -- error for a recording that is merely minimal.

    related:
        TopMethodsView() when workspace.has_recording
        FlamegraphView() when workspace.has_recording
        HeatmapView() when workspace.has_recording
        MergedCallsView() when workspace.has_recording
}

surface TopMethodsView {
    facing analyst: Analyst

    exposes:
        workspace.active_recording.selection_size
        -- The selection chrome, shared by every specialized view: the
        -- current selection summarised in one line, the thread panel,
        -- the timeline strip carrying the brush, and the menu of saved
        -- selections — all scoped to the active recording.
        workspace.active_recording.selected_threads
        workspace.active_recording.selected_window
        for thread in workspace.active_recording.profile.threads:
            thread.name
            thread.sample_count
        for selection in workspace.active_recording.saved_selections:
            selection.name
        for frame in workspace.active_recording.top_methods:
            frame.class_name
            frame.method_name
            frame.self_samples
            frame.total_samples

    provides:
        AnalystSelectsThreads(analyst, threads)
            when workspace.has_recording
        AnalystClearsThreadSelection(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_threads != null
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording
        AnalystClearsTimeWindow(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_window != null
        AnalystSavesSelection(analyst)
            when workspace.has_recording
                and (workspace.active_recording.selected_threads != null
                    or workspace.active_recording.selected_window != null)
        AnalystAppliesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystClearsSelection(analyst)
            when workspace.has_recording
        AnalystRenamesSelection(analyst, selection, wanted)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystDeletesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        -- Picking a method here is the "inspect this" gesture: it hands
        -- over to the merged-calls view.
        AnalystSelectsMethod(analyst, frame)
            when workspace.has_recording

    @guarantee RowsAreOrderedBySelfTime
        -- Rows are ordered by decreasing self count, and that order is
        -- total: two runs over the same selection produce the same
        -- sequence of rows.

    @guarantee PercentagesShareOneDenominator
        -- Self and total percentages are read against the size of the
        -- active recording's current selection, not against the whole
        -- recording, and not against any other open recording.

    @guarantee EmptyingAFilterWidensTheTable
        -- Emptying a filter never shrinks the table: deselecting every
        -- thread, or brushing a window that holds no instant, widens
        -- the selection back to the whole recording. A table can still
        -- come out empty, but only from a selection that genuinely
        -- matches no sample — a thread that was idle throughout the
        -- selected window, say.

    @guarantee ThreadsAreOrderedByActivity
        -- The thread panel lists threads by decreasing whole-recording
        -- sample count. The shares shown next to them are read against
        -- the whole recording too: they describe the recording, not the
        -- selection, so they hold still while the analyst narrows.

    @guarantee EditingDetachesTheAppliedSelection
        -- After applying a saved selection, editing any filter leaves
        -- the saved entry untouched: the current selection becomes
        -- anonymous again. A saved selection only changes through an
        -- explicit rename or delete.

    @guidance
        -- The timeline strip under the view draws the sample density of
        -- the whole recording, never the filtered one: it is the map the
        -- analyst brushes on, and the brush needs the surroundings to
        -- show where the window sits.

    @guidance
        -- The analyst reads this table to find where time goes: a high
        -- self count means the method itself is hot, a high total with
        -- a low self means it is the entry point of something hot.

    related:
        MergedCallsView() when workspace.has_recording
}

-- The call-tree view: every distinct stack the current selection
-- reaches, merged by shared prefix into nested spans sized by sample
-- count. Complements top-methods: where the flat profile counts a
-- method once per sample no matter how often it recurses, the
-- flamegraph shows every occurrence at the depth it happened.
surface FlamegraphView {
    facing analyst: Analyst

    exposes:
        workspace.active_recording.selection_size
        -- The selection chrome, shared with top-methods.
        workspace.active_recording.selected_threads
        workspace.active_recording.selected_window
        for thread in workspace.active_recording.profile.threads:
            thread.name
            thread.sample_count
        for selection in workspace.active_recording.saved_selections:
            selection.name
        for stack in workspace.active_recording.selected_stacks:
            stack.frames
            stack.selected_sample_count

    provides:
        AnalystSelectsThreads(analyst, threads)
            when workspace.has_recording
        AnalystClearsThreadSelection(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_threads != null
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording
        AnalystClearsTimeWindow(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_window != null
        AnalystSavesSelection(analyst)
            when workspace.has_recording
                and (workspace.active_recording.selected_threads != null
                    or workspace.active_recording.selected_window != null)
        AnalystAppliesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystClearsSelection(analyst)
            when workspace.has_recording
        AnalystRenamesSelection(analyst, selection, wanted)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystDeletesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        -- Picking a frame here is the same "inspect this" gesture as in
        -- top-methods: it hands over to the merged-calls view.
        AnalystSelectsMethod(analyst, frame)
            when workspace.has_recording

    @guarantee RecursionIsShownNotCollapsed
        -- A method that calls itself appears once per depth it occurs
        -- at, nested inside its own span, rather than merged into one
        -- count the way the flat profile merges it.

    @guarantee SpanWidthIsSampleShare
        -- Every span's width is proportional to the selected samples
        -- whose stack passes through it, and a span never spans less
        -- width than the spans nested inside it.

    @guarantee ZoomingIsLocalToTheView
        -- Clicking a span focuses the tree on it: that span becomes
        -- the top-level span its descendants are drawn from. Zooming
        -- narrows what is drawn from the tree already fetched; it
        -- changes neither the thread nor the time selection, so it
        -- never triggers a new fetch on its own.

    @guarantee AncestorsStayReachableWhileZoomed
        -- The focused span's own ancestors are drawn above it, one
        -- full-width row per ancestor, in call order down to the
        -- focus. The view scrolls so the focus sits at the top by
        -- default, hiding them, but the analyst can scroll back up to
        -- see them and click one to make it the new focus in turn.

    @guarantee ResettingZoomReturnsToTheWholeTree
        -- Resetting the zoom returns to the unzoomed tree in one step
        -- regardless of how many ancestors the analyst had scrolled
        -- past to get there.

    @guarantee ZoomResetsWithTheSelection
        -- Changing the thread or time selection fetches a new tree and
        -- clears any zoom: the span that was focused belonged to the
        -- previous selection and may not exist in the new one.

    @guidance
        -- The timeline strip and thread panel are the same selection
        -- chrome as top-methods: narrowing the selection here narrows
        -- it there too, and vice versa.

    related:
        MergedCallsView() when workspace.has_recording
}

-- The FlameScope-style heatmap: sample density over the whole recording,
-- bucketed into columns of a fixed span (a second) split into rows of a
-- fixed width within it (twenty milliseconds), so a phenomenon that
-- recurs every column lands in the same row from one column to the next
-- and reads as a visible line. Complements top-methods and the
-- flamegraph as the surface the analyst brushes a new time window from,
-- rather than one they narrow with an existing selection.
surface HeatmapView {
    facing analyst: Analyst

    exposes:
        workspace.active_recording.selection_size
        workspace.active_recording.profile.duration_nanos
        -- The selection chrome, shared with top-methods and the
        -- flamegraph.
        workspace.active_recording.selected_threads
        workspace.active_recording.selected_window
        for thread in workspace.active_recording.profile.threads:
            thread.name
            thread.sample_count
        for selection in workspace.active_recording.saved_selections:
            selection.name

    provides:
        AnalystSelectsThreads(analyst, threads)
            when workspace.has_recording
        AnalystClearsThreadSelection(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_threads != null
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording
        AnalystClearsTimeWindow(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_window != null
        AnalystSavesSelection(analyst)
            when workspace.has_recording
                and (workspace.active_recording.selected_threads != null
                    or workspace.active_recording.selected_window != null)
        AnalystAppliesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystClearsSelection(analyst)
            when workspace.has_recording
        AnalystRenamesSelection(analyst, selection, wanted)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystDeletesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0

    @guarantee HeatmapSpansTheWholeRecording
        -- The grid's columns always cover the whole recording, regardless
        -- of the current thread or time selection: this is the surface
        -- the analyst brushes a new window from, so it needs the whole
        -- recording as context to place that window against. Only which
        -- samples populate a cell follows the current selection, exactly
        -- like every other view.

    @guarantee BrushingSetsTheTimeWindow
        -- Dragging a rectangle of cells sets the time window to the span
        -- it bounds: covering every row of the columns it spans reaches
        -- exactly those columns' span, while staying within a single
        -- column's rows narrows to a slice inside one second — finer
        -- than the timeline brush, and unique to this view.

    @guidance
        -- The selection chrome is the same as top-methods and the
        -- flamegraph: narrowing it here narrows it everywhere, and vice
        -- versa. A time window already selected elsewhere still shows
        -- against the whole-recording grid, per HeatmapSpansTheWholeRecording,
        -- so the analyst can see where it sits before adjusting it.
}

-- Callers and callees merged around one focused method: complements
-- top-methods and the flamegraph by showing what leads into a hot
-- method and what it leads to, without the rest of the call tree
-- around it. The analyst reaches it by selecting a method from
-- top-methods or the flamegraph.
surface MergedCallsView {
    facing analyst: Analyst

    exposes:
        workspace.active_recording.selection_size
        workspace.active_recording.focused_frame
        -- The selection chrome, shared with the other views.
        workspace.active_recording.selected_threads
        workspace.active_recording.selected_window
        for thread in workspace.active_recording.profile.threads:
            thread.name
            thread.sample_count
        for selection in workspace.active_recording.saved_selections:
            selection.name

    provides:
        AnalystSelectsMethod(analyst, frame)
            when workspace.has_recording
        AnalystClearsMethodSelection(analyst)
            when workspace.has_recording
                and workspace.active_recording.focused_frame != null
        AnalystSelectsThreads(analyst, threads)
            when workspace.has_recording
        AnalystClearsThreadSelection(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_threads != null
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording
        AnalystClearsTimeWindow(analyst)
            when workspace.has_recording
                and workspace.active_recording.selected_window != null
        AnalystSavesSelection(analyst)
            when workspace.has_recording
                and (workspace.active_recording.selected_threads != null
                    or workspace.active_recording.selected_window != null)
        AnalystAppliesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystClearsSelection(analyst)
            when workspace.has_recording
        AnalystRenamesSelection(analyst, selection, wanted)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0
        AnalystDeletesSelection(analyst, selection)
            when workspace.has_recording
                and workspace.active_recording.saved_selections.count > 0

    @guarantee FocusedFrameRootsBothTrees
        -- Both trees are rooted at the focused method: its sample count
        -- is the same figure the flat profile calls total_samples, read
        -- once instead of once per view.

    @guarantee CallersAndCalleesSplitAtTheFirstOccurrence
        -- A stack that recurses through the focused method is split at
        -- its first occurrence: everything before it feeds the callers
        -- tree, everything from that occurrence on feeds the callees
        -- tree, each merged the way the flamegraph merges stacks —
        -- callers by shared suffix walking up, callees by shared prefix
        -- walking down.

    @guarantee SelectionSurvivesFilterChanges
        -- Selecting a method is not a filter: narrowing or widening the
        -- thread or time selection re-fetches both trees for the same
        -- focused method instead of clearing it, unlike zooming into
        -- the flamegraph.

    @guidance
        -- The selection chrome is the same as the other views: narrowing
        -- it here narrows it everywhere, and vice versa.

    @guidance
        -- Selecting a different method from top-methods or the
        -- flamegraph replaces the focused method rather than requiring
        -- an explicit clear first.
}
