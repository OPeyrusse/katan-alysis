-- allium: 3
-- katan-alysis.allium
--
-- Scope: the JFR analysis desktop application — opening a recording,
-- narrowing it with the cross-cutting filters, and reading the flat
-- profile ("top methods") view.
--
-- Includes:
--   - the outcome of opening a recording (loaded summary vs. error)
--   - closing the recording, back to the welcome screen
--   - the recent-recordings list: remembered opens, persisted across
--     application restarts
--   - the normalised profile: frames, stacks, threads, samples
--   - the recording's own description (JVM, GC, host, key flags) and
--     the overview that presents it with the recorded signals
--   - the thread and time filters, applied before any aggregation
--   - the top-methods aggregation (self / total sample counts)
--   - the boundaries the analyst interacts with
-- Excludes:
--   - the JFR binary format and its parsing (jfrs library, external)
--   - transport (Tauri IPC), rendering technology and packaging
--   - views not yet built: flamegraph, heatmap, merged call tree
--   - several recordings open at once. It is a decided direction, not
--     an open question: the workspace will hold more than one profile
--     so recordings can be compared. Until that work starts the spec
--     describes the one-recording workspace that exists (docs/PLAN.md).

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    workspace: AnalysisWorkspace
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A JFR file on disk. Produced by a JVM or by async-profiler; the
-- application only ever reads it.
external entity Recording {
    path: String
}

-- The person driving the application. The system holds no account or
-- identity of its own; the analyst is whoever operates the workspace.
external entity Analyst {
    name: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- An interval of recording-relative nanoseconds, both bounds included:
-- the analyst who selects the whole span keeps every sample, last one
-- included. A window whose end precedes its start holds no instant and
-- is therefore empty — it narrows nothing.
value TimeWindow {
    start_nanos: Integer
    end_nanos: Integer

    duration_nanos: end_nanos - start_nanos
    is_empty: end_nanos < start_nanos
}

-- One line of the welcome screen's recents list: enough to recognise a
-- recording and reopen it, nothing read from inside the file.
value RecentEntry {
    path: String
    size_bytes: Integer
    last_opened_ms: Integer
}

-- A selection the analyst saved under a name: the two filters, frozen.
-- Null halves mean the same as on the workspace — not narrowed.
value SavedSelection {
    name: String
    threads: Set<ProfiledThread>?
    window: TimeWindow?
}

-- A JVM flag captured at recording start: its value and where it came
-- from ("Command line", "Ergonomic", "Default"...). The origin is what
-- lets the analyst tell an explicit -Xmx from an ergonomic one.
value JvmFlag {
    value: Integer
    origin: String
}

-- Boolean twin of JvmFlag, for on/off diagnostics flags.
value ToggleFlag {
    enabled: Boolean
    origin: String
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A method, identified independently of where it appears in a stack.
-- Two occurrences of the same method are the same frame.
entity Frame {
    profile: Profile
    class_name: String
    method_name: String

    -- Samples whose innermost frame is this method: it was the one
    -- running on CPU.
    leaf_samples: Sample with leaf_frame = this
    -- Samples that have this method anywhere in their stack. Counted
    -- once per sample, even when the stack recurses through it.
    covering_samples: Sample with this in distinct_frames

    -- Both counts are relative to the current selection: filters are
    -- applied to the sample stream before anything is aggregated.
    selected_leaf_samples: leaf_samples where is_selected
    selected_covering_samples: covering_samples where is_selected

    self_samples: selected_leaf_samples.count
    total_samples: selected_covering_samples.count

    is_visible: total_samples > 0
}

-- One call stack, root first and leaf last. Stacks are shared: many
-- samples point at the same stack.
entity Stack {
    profile: Profile
    frames: List<Frame>

    leaf: frames.last
    distinct_frames: frames.unique
}

-- A thread observed in the recording.
entity ProfiledThread {
    profile: Profile
    name: String

    -- Whole-recording activity, deliberately blind to the current
    -- selection: the thread panel orders and annotates by it, and
    -- entries must not jump around while the analyst filters.
    samples: Sample with thread = this
    sample_count: samples.count
}

-- One execution sample: an instant, a thread, and the stack that
-- thread was running.
entity Sample {
    profile: Profile
    ts_nanos: Integer
    thread: ProfiledThread
    stack: Stack

    leaf_frame: stack.leaf
    distinct_frames: stack.distinct_frames

    -- The filters are cross-cutting: every view sees the same selected
    -- samples, so no view may re-filter or post-process aggregated data.
    matches_thread_filter:
        workspace.selected_threads = null
        or thread in workspace.selected_threads
    matches_time_filter:
        workspace.selected_window = null
        or (ts_nanos >= workspace.selected_window.start_nanos
            and ts_nanos <= workspace.selected_window.end_nanos)
    is_selected: matches_thread_filter and matches_time_filter
}

-- A recording turned into the shape every view consumes. Produced once
-- when the recording is opened, then only queried.
entity Profile {
    source: Recording

    frames: Frame with profile = this
    stacks: Stack with profile = this
    threads: ProfiledThread with profile = this
    samples: Sample with profile = this

    -- What the recording says about the JVM that produced it. Every
    -- field may be absent — an async-profiler recording, or one made
    -- with minimal settings, carries no metadata events at all — and
    -- absence reads as "n/a", never as an error.
    jvm_name: String?
    jvm_version: String?
    young_collector: String?
    old_collector: String?
    heap_max_bytes: Integer?
    os_description: String?
    cpu_cores: Integer?
    physical_memory_bytes: Integer?
    xmx: JvmFlag?
    xms: JvmFlag?
    max_direct_memory: JvmFlag?
    debug_non_safepoints: ToggleFlag?

    sample_count: samples.count
    first_sample_nanos: earliest(samples)
    last_sample_nanos: latest(samples)
    -- The span the analyst can select within; timestamps shown to the
    -- analyst are relative to the first sample, never absolute.
    duration_nanos: last_sample_nanos - first_sample_nanos
}

-- The application state: at most one recording open, plus the filters
-- currently narrowing it.
entity AnalysisWorkspace {
    -- Absent until a recording has been opened successfully.
    profile: Profile?
    -- Absent means "every thread" / "the whole recording". An empty
    -- filter is not a filter: selecting no thread, or a window holding
    -- no instant, narrows nothing rather than emptying the views. The
    -- analyst who deselects everything is not asking to see nothing,
    -- and each category is independent — an empty thread selection
    -- leaves an active time window alone.
    selected_threads: Set<ProfiledThread>?
    selected_window: TimeWindow?
    -- Why the last attempt to open a recording failed, if it did.
    last_error: String?
    -- What the welcome screen lists: recordings whose last open
    -- succeeded, most recent first. Unlike the rest of the workspace
    -- this list survives an application restart.
    recent_recordings: List<RecentEntry>
    -- Selections saved under a name for the current recording, in save
    -- order. In memory only: they die with the recording session.
    saved_selections: List<SavedSelection>

    has_recording: profile != null
    selected_samples: profile.samples where is_selected
    -- The denominator of every percentage the analyst reads.
    selection_size: selected_samples.count
    top_methods: profile.frames where is_visible

    invariant FiltersRequireARecording {
        not has_recording
            implies selected_threads = null and selected_window = null
    }

    invariant SelectionsRequireARecording {
        not has_recording implies saved_selections.count = 0
    }

    -- One name designates one saved selection; conflicts are resolved
    -- with a numeric suffix as names are taken.
    invariant SavedSelectionNamesAreUnique {
        saved_selections.name.unique.count = saved_selections.count
    }

    -- Empty filters are normalised away as they are selected, so no
    -- view has to decide what an empty filter means.
    invariant NoEmptyFilterIsEverHeld {
        (selected_threads = null or selected_threads.count > 0)
            and (selected_window = null or not selected_window.is_empty)
    }

    -- The list is a shortlist, not a history: at most ten entries, one
    -- per path — reopening a recording moves its entry to the front
    -- instead of duplicating it.
    invariant RecentsStayAShortlist {
        recent_recordings.count <= 10
            and recent_recordings.path.unique.count = recent_recordings.count
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule LoadRecording {
    when: AnalystOpensRecording(analyst, recording)
    requires: is_readable(recording)
    requires: has_execution_samples(recording)
    ensures:
        workspace.profile = Profile.created(source: recording)
        -- A new recording starts unfiltered: filters from the previous
        -- one would silently narrow a different data set.
        workspace.selected_threads = null
        workspace.selected_window = null
        workspace.last_error = null
        -- Saved selections named windows of the previous recording;
        -- they would silently describe a different data set here.
        workspace.saved_selections = []
        -- The open is remembered: the recording's entry moves to (or
        -- appears at) the front of the recents list, and the entry
        -- beyond the shortlist bound, if any, falls off the end.
        workspace.recent_recordings =
            remembered(workspace.recent_recordings, recording)
    @guidance
        -- Samples with no resolvable stack or thread contribute to no
        -- view and are dropped while reading; a recording made only of
        -- such samples is an unusable recording.
}

rule RejectUnusableRecording {
    when: AnalystOpensRecording(analyst, recording)
    requires: not is_readable(recording) or not has_execution_samples(recording)
    ensures:
        -- The workspace keeps whatever was already open: a failed open
        -- never costs the analyst the recording they were reading, and
        -- never rewrites the recents list.
        workspace.last_error = failure_reason(recording)
}

rule CloseRecording {
    when: AnalystClosesRecording(analyst)
    requires: workspace.has_recording
    ensures:
        -- Filters and saved selections die with the recording they
        -- narrowed. The recents list is untouched: closing is not
        -- forgetting.
        workspace.profile = null
        workspace.selected_threads = null
        workspace.selected_window = null
        workspace.saved_selections = []
        workspace.last_error = null
}

rule ForgetRecentRecording {
    when: AnalystRemovesRecent(analyst, path)
    ensures:
        workspace.recent_recordings =
            without(workspace.recent_recordings, path)
}

rule ClearRecentRecordings {
    when: AnalystClearsRecents(analyst)
    requires: workspace.recent_recordings.count > 0
    ensures:
        workspace.recent_recordings = []
}

rule NarrowToThreads {
    when: AnalystSelectsThreads(analyst, threads)
    requires: workspace.has_recording
    ensures:
        if threads.count = 0:
            workspace.selected_threads = null
        else:
            workspace.selected_threads = threads
}

rule WidenToAllThreads {
    when: AnalystClearsThreadSelection(analyst)
    requires: workspace.selected_threads != null
    ensures: workspace.selected_threads = null
}

rule NarrowToTimeWindow {
    when: AnalystSelectsTimeWindow(analyst, window)
    requires: workspace.has_recording
    ensures:
        -- A brush that selects no instant clears the time filter; it is
        -- how the analyst backs out of a selection, not a rejected
        -- action.
        if window.is_empty:
            workspace.selected_window = null
        else:
            workspace.selected_window = window
}

rule WidenToWholeRecording {
    when: AnalystClearsTimeWindow(analyst)
    requires: workspace.selected_window != null
    ensures: workspace.selected_window = null
}

rule SaveCurrentSelection {
    when: AnalystSavesSelection(analyst)
    -- Saving the absence of selection would duplicate the built-in
    -- "no selection" entry, so there must be something to name.
    requires: workspace.selected_threads != null
        or workspace.selected_window != null
    ensures:
        -- The default name describes the selection — the period (or
        -- "whole recording") and the thread count (or "all threads");
        -- a name conflict takes the first free " (n)" suffix, n >= 2.
        workspace.saved_selections = with_saved(
            workspace.saved_selections,
            workspace.selected_threads,
            workspace.selected_window)
}

rule ApplySavedSelection {
    when: AnalystAppliesSelection(analyst, selection)
    requires: selection in workspace.saved_selections
    ensures:
        workspace.selected_threads = selection.threads
        workspace.selected_window = selection.window
}

-- The "no selection" entry of the selection menu: every thread, the
-- whole recording, in one gesture.
rule ApplyNoSelection {
    when: AnalystClearsSelection(analyst)
    requires: workspace.has_recording
    ensures:
        workspace.selected_threads = null
        workspace.selected_window = null
}

rule RenameSavedSelection {
    when: AnalystRenamesSelection(analyst, selection, wanted)
    requires: selection in workspace.saved_selections
    ensures:
        -- Same conflict rule as saving; a blank name changes nothing.
        workspace.saved_selections = renamed(
            workspace.saved_selections, selection, wanted)
}

rule DeleteSavedSelection {
    when: AnalystDeletesSelection(analyst, selection)
    requires: selection in workspace.saved_selections
    ensures:
        -- Deleting forgets the name, not the current selection: the
        -- filters the entry may have produced stay in place.
        workspace.saved_selections = without_selection(
            workspace.saved_selections, selection)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A method cannot be on CPU in a sample it does not appear in.
invariant SelfNeverExceedsTotal {
    for frame in Frames:
        frame.self_samples <= frame.total_samples
}

-- No method can cover more samples than the selection holds.
invariant TotalBoundedBySelection {
    for frame in Frames:
        frame.total_samples <= workspace.selection_size
}

-- Exactly one method is on CPU per sample, so the self counts of a
-- profile partition its selection.
invariant SelfCountsPartitionTheSelection {
    sum_of(Frames, f => f.self_samples) = workspace.selection_size
}

-- Every sample belongs to the recording it was read from, and so does
-- every stack it points at.
invariant SamplesAreInternallyConsistent {
    for sample in Samples:
        sample.stack.profile = sample.profile
            and sample.thread.profile = sample.profile
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RecordingLoader {
    facing analyst: Analyst

    exposes:
        workspace.has_recording
        workspace.last_error
        workspace.profile.sample_count
        workspace.profile.duration_nanos
        workspace.profile.threads.name
        for entry in workspace.recent_recordings:
            entry.path
            entry.size_bytes
            entry.last_opened_ms

    provides:
        AnalystOpensRecording(analyst, recording)
        AnalystClosesRecording(analyst)
            when workspace.has_recording
        AnalystRemovesRecent(analyst, path)
            when workspace.recent_recordings.count > 0
        AnalystClearsRecents(analyst)
            when workspace.recent_recordings.count > 0

    @guarantee FailedOpenIsReported
        -- Opening a recording either yields a summary or a message
        -- naming what went wrong. It never fails silently, and never
        -- leaves the analyst looking at a half-loaded recording.

    @guarantee OnlySuccessfulOpensAreRemembered
        -- The recents list is a list of recordings that actually
        -- opened: a failed open changes the error message, never the
        -- list. Removing an entry, or clearing the list, forgets the
        -- shortcut only — the file on disk is not the application's to
        -- touch.

    @guarantee RecentsSurviveARestart
        -- The list is the one piece of workspace state that outlives
        -- the process: quitting and relaunching the application shows
        -- the same recents. Everything else — the loaded recording, the
        -- filters — starts fresh.

    related:
        RecordingOverview() when workspace.has_recording
        TopMethodsView() when workspace.has_recording
}

-- The landing view of a freshly opened recording: what the recording
-- says about itself, and its vital signs over time.
surface RecordingOverview {
    facing analyst: Analyst

    exposes:
        workspace.profile.jvm_name
        workspace.profile.jvm_version
        workspace.profile.young_collector
        workspace.profile.old_collector
        workspace.profile.heap_max_bytes
        workspace.profile.os_description
        workspace.profile.cpu_cores
        workspace.profile.physical_memory_bytes
        workspace.profile.xmx
        workspace.profile.xms
        workspace.profile.max_direct_memory
        workspace.profile.debug_non_safepoints

    provides:
        -- Brushing a period on any chart is the "analyze this period"
        -- gesture: it narrows the time window and hands over to the
        -- top-methods view.
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording

    @guarantee ChartsShareTheRecordingClock
        -- The overview draws four signals — CPU load, heap occupancy,
        -- process memory (RSS), GC pauses — as recorded, over one
        -- shared time axis spanning the whole recording. The hover
        -- cursor is one cursor: pointing at an instant points at it in
        -- all four charts.

    @guarantee MissingDataIsNamed
        -- A signal the recording does not carry shows as "not in this
        -- recording", and an absent fact as "n/a" — never an empty
        -- chart the analyst could mistake for a flat line, never an
        -- error for a recording that is merely minimal.

    related:
        TopMethodsView() when workspace.has_recording
}

surface TopMethodsView {
    facing analyst: Analyst

    exposes:
        workspace.selection_size
        -- The selection chrome, shared by every specialized view: the
        -- current selection summarised in one line, the thread panel,
        -- the timeline strip carrying the brush, and the menu of saved
        -- selections.
        workspace.selected_threads
        workspace.selected_window
        for thread in workspace.profile.threads:
            thread.name
            thread.sample_count
        for selection in workspace.saved_selections:
            selection.name
        for frame in workspace.top_methods:
            frame.class_name
            frame.method_name
            frame.self_samples
            frame.total_samples

    provides:
        AnalystSelectsThreads(analyst, threads)
            when workspace.has_recording
        AnalystClearsThreadSelection(analyst)
            when workspace.selected_threads != null
        AnalystSelectsTimeWindow(analyst, window)
            when workspace.has_recording
        AnalystClearsTimeWindow(analyst)
            when workspace.selected_window != null
        AnalystSavesSelection(analyst)
            when workspace.selected_threads != null
                or workspace.selected_window != null
        AnalystAppliesSelection(analyst, selection)
            when workspace.saved_selections.count > 0
        AnalystClearsSelection(analyst)
            when workspace.has_recording
        AnalystRenamesSelection(analyst, selection, wanted)
            when workspace.saved_selections.count > 0
        AnalystDeletesSelection(analyst, selection)
            when workspace.saved_selections.count > 0

    @guarantee RowsAreOrderedBySelfTime
        -- Rows are ordered by decreasing self count, and that order is
        -- total: two runs over the same selection produce the same
        -- sequence of rows.

    @guarantee PercentagesShareOneDenominator
        -- Self and total percentages are read against the size of the
        -- current selection, not against the whole recording.

    @guarantee EmptyingAFilterWidensTheTable
        -- Emptying a filter never shrinks the table: deselecting every
        -- thread, or brushing a window that holds no instant, widens
        -- the selection back to the whole recording. A table can still
        -- come out empty, but only from a selection that genuinely
        -- matches no sample — a thread that was idle throughout the
        -- selected window, say.

    @guarantee ThreadsAreOrderedByActivity
        -- The thread panel lists threads by decreasing whole-recording
        -- sample count. The shares shown next to them are read against
        -- the whole recording too: they describe the recording, not the
        -- selection, so they hold still while the analyst narrows.

    @guarantee EditingDetachesTheAppliedSelection
        -- After applying a saved selection, editing any filter leaves
        -- the saved entry untouched: the current selection becomes
        -- anonymous again. A saved selection only changes through an
        -- explicit rename or delete.

    @guidance
        -- The timeline strip under the view draws the sample density of
        -- the whole recording, never the filtered one: it is the map the
        -- analyst brushes on, and the brush needs the surroundings to
        -- show where the window sits.

    @guidance
        -- The analyst reads this table to find where time goes: a high
        -- self count means the method itself is hot, a high total with
        -- a low self means it is the entry point of something hot.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "When several recordings are open at once, is a filter selection per recording or shared across them?"
